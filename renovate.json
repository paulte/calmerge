{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],

  "enabledManagers": [
    "github-actions",
    "pep621",
    "pip_requirements",
    "pip-compile",
    "pre-commit"
  ],

  "pre-commit": {
    "enabled": true
  },

  "dependencyDashboard": true,

  "labels": [
    "dependencies"
  ]
}
