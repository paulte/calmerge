{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],

  "enabledManagers": [
    "github-actions",
    "pep621",
    "pip_requirements",
    "pip-compile",
    "pre-commit"
  ],

  "pre-commit": {
    "enabled": true
  },

  "dependencyDashboard": true,

  "labels": [
    "dependencies"
  ],

  "packageRules": [
    {
      "description": "Automerge patch and minor dependency updates",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge GitHub Actions digest updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
